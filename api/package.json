{
  "name": "@aegis/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "test": "vitest run",
    "migrate": "tsx --env-file=../.env src/migrate.ts",
    "seed": "tsx --env-file=../.env src/seed/index.ts",
    "demo:smoke": "tsx scripts/demo-smoke.ts",
    "start": "tsx --env-file=../.env src/server.ts",
    "dev:offline": "cross-env OFFLINE=1 tsx --env-file=../.env src/server.ts",
    "build:cc": "npm --prefix ../chaincode/aegis-cc run build --silent",
    "pretest": "npm --prefix ../chaincode/aegis-cc run build --silent",
    "predev": "npm --prefix ../chaincode/aegis-cc run build --silent",
    "predev:offline": "npm --prefix ../chaincode/aegis-cc run build --silent",
    "prestart": "npm --prefix ../chaincode/aegis-cc run build --silent",
    "preseed": "npm --prefix ../chaincode/aegis-cc run build --silent",
    "sync:identities": "tsx --env-file=../.env scripts/sync-identities.ts",
    "eval:tamper": "npm --prefix ../chaincode/aegis-cc run build --silent && tsx --env-file-if-exists=../.env scripts/eval-tamper.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@electric-sql/pglite": "0.3.14",
    "@electric-sql/pglite-socket": "0.0.22",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@grpc/grpc-js": "^1.14.6",
    "@hyperledger/fabric-gateway": "1.7",
    "argon2": "^0.45.1",
    "fabric-ca-client": "2.2",
    "fabric-common": "2.2",
    "fastify": "^5.12.7",
    "file-type": "^22.2.0",
    "jose": "^6.2.12",
    "otplib": "12",
    "pg": "^8.23.1",
    "zod": "3"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
